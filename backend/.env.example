# Copy to .env and fill in your values
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graverescue
PORT=3001
CORS_ORIGIN=http://localhost:5173
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=graverescue-photos
R2_PUBLIC_URL=

# Email — Resend (https://resend.com)
# Domain must be verified in the Resend dashboard before sending.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@graverescue.com
ADMIN_NOTIFY_EMAIL=jgillispie89@gmail.com
FRONTEND_URL=https://graverescue.com
